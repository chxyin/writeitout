# Required: DeepSeek key used by POST /api/grade
DEEPSEEK_API_KEY=your_api_key_here

# Required for saving: the pooled Postgres connection string. Without it the API
# runs against an in-memory store — everything works, nothing is remembered.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Google Sign-In. The backend verifies the ID token the browser sends, so it must
# name the same OAuth client the frontend was built with. It is public, and the
# default is this deployment's Web client; set it only to point a fork elsewhere.
# GOOGLE_CLIENT_ID=802894837975-lmjp3uam5tjc641a8sfknsb59218mtoe.apps.googleusercontent.com

# Who may open /api/admin/*. Comma-separated.
# ADMIN_EMAILS=jasonluchunyin2010@gmail.com

# Answer storage policy: full (text), redacted (score/length only), off (never).
# The admin API can override this at runtime; this is the starting value.
# POI_STORAGE_MODE=full

# Salt for the analytics IP hash. Change it to make old hashes unlinkable.
# ANALYTICS_SALT=writeitout

# Optional overrides (defaults shown)
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=40
# RATE_LIMIT_REQUESTS=12
# RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_REQUESTS=20
# Comma-separated browser origins; defaults to GitHub Pages + local Vite
# ALLOWED_ORIGINS=https://chxyin.github.io,http://localhost:5173
