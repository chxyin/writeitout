# Google Sign-In. Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials and paste its client ID here.
# The value is baked into the bundle at build time, so restart `npm run dev`
# after editing it.
#
# Authorised JavaScript origins must cover every origin the app is served from:
#   http://localhost:5173              (npm run dev)
#   https://chxyin.github.io           (GitHub Pages deploy)
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
