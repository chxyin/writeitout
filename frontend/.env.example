# Google Sign-In — this project's Web client.
#
# The client ID is public: it is baked into the bundle and readable in the built
# JS. It only works from the origins registered on the client, so a fork needs its
# own client ID here (or in the repository secret used by the deploy workflow).
#
# Authorised JavaScript origins on the client must cover every origin the app is
# served from:
#   http://localhost:5173              (npm run dev)
#   http://127.0.0.1:5173              (npm run dev, IP form)
#   https://chxyin.github.io           (GitHub Pages deploy)
VITE_GOOGLE_CLIENT_ID=802894837975-lmjp3uam5tjc641a8sfknsb59218mtoe.apps.googleusercontent.com
